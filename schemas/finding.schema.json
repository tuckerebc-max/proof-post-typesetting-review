{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mwm.local/schemas/ppr/finding.schema.json",
  "title":"PPR Proof Finding",
  "type":"object",
  "additionalProperties":false,
  "required":["finding_id","skill_id","baseline_id","proof_id","location","defect_type","severity","current_state","expected_state","evidence","authority","correction_instruction","owner","status","impact","confidence","release_effect","created_at","updated_at"],
  "properties":{
    "finding_id":{"type":"string","pattern":"^PPR-FND-"},
    "skill_id":{"type":"string","pattern":"^PPR-[0-9]{2}$"},
    "baseline_id":{"type":"string","pattern":"^PPR-BL-"},
    "proof_id":{"type":"string"},
    "location":{"type":"object","additionalProperties":false,"required":["locator"],"properties":{"locator":{"type":"string"},"page":{"type":["integer","null"]},"object_id":{"type":["string","null"]},"format":{"type":["string","null"]}}},
    "defect_type":{"type":"string","enum":["approved_variation","typesetter_error","factual_or_meaning_error","author_alteration","query_open","source_unavailable","asset_issue","accessibility_signal","status_issue","resolved","blocked"]},
    "severity":{"type":"string","enum":["low","moderate","high","critical"]},
    "current_state":{"type":"string"},
    "expected_state":{"type":"string"},
    "evidence":{"type":"array","items":{"type":"string"}},
    "authority":{"type":"string"},
    "correction_instruction":{"type":"string"},
    "owner":{"type":"string"},
    "status":{"type":"string","enum":["open","accepted","rejected","incorporated","reproof_required","resolved","blocked","deferred","referred"]},
    "impact":{"type":"string","enum":["meaning","credit","navigation","indexing","pagination","accessibility","rights","privacy","cosmetic"]},
    "confidence":{"type":"string","enum":["high","medium","low"]},
    "release_effect":{"type":"string","enum":["none","track","hold","block"]},
    "correction_id":{"type":["string","null"]},
    "created_at":{"type":"string","format":"date-time"},
    "updated_at":{"type":"string","format":"date-time"}
  }
}

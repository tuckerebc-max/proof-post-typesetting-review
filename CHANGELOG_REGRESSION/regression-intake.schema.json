{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mwm.local/schemas/ppr/regression-intake.schema.json",
  "title":"PPR Regression Intake",
  "type":"object",
  "additionalProperties":false,
  "required":["regression_id","reported_at","reported_by","source","summary","affected_rule_ids","fixture_ids","severity","status","owner","expected_behavior","observed_behavior","retest_required"],
  "properties":{
    "regression_id":{"type":"string","pattern":"^PPR-REG-"},"reported_at":{"type":"string","format":"date-time"},"reported_by":{"type":"string"},"source":{"type":"string","enum":["evaluation","production","human_qa","upstream_skill","profile_change","specification_change"]},"summary":{"type":"string"},"affected_rule_ids":{"type":"array","items":{"type":"string","pattern":"^PPR-"}},"fixture_ids":{"type":"array","items":{"type":"string"}},"severity":{"type":"string","enum":["low","medium","high","critical"]},"status":{"type":"string","enum":["new","triaged","accepted","rejected","fixed","verified","closed"]},"owner":{"type":"string"},"expected_behavior":{"type":"string"},"observed_behavior":{"type":"string"},"decision_hook_ids":{"type":"array","items":{"type":"string","pattern":"^PPR-DH-"}},"retest_required":{"type":"boolean"},"retest_result":{"type":["string","null"]},"closed_at":{"type":["string","null"],"format":"date-time"}
  }
}
